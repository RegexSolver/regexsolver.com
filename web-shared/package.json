{
  "name": "@regexsolver/web-shared",
  "version": "0.0.0",
  "private": true,
  "description": "Cross-app frontend logic and components shared by the website, console and docs: consent + theme cookies (cross-subdomain), PostHog init, cookie banner, footer content, logo. Ships raw TypeScript \u2014 consumers bundle it (all use moduleResolution: bundler).",
  "type": "module",
  "exports": {
    "./analytics": "./src/analytics.ts",
    "./brand": "./src/brand.ts",
    "./consent": "./src/consent.ts",
    "./cookie-banner": "./src/cookie-banner.ts",
    "./site-links": "./src/site-links.ts",
    "./theme": "./src/theme.ts",
    "./fonts/preload": "./fonts/preload.ts",
    "./fonts/fonts.css": "./fonts/fonts.css",
    "./components/Logo": "./src/components/Logo.tsx",
    "./components/CookieBanner": "./src/components/CookieBanner.tsx",
    "./components/FooterContent": "./src/components/FooterContent.tsx"
  },
  "peerDependencies": {
    "react": ">=19.0.0"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "@types/react": "^19.0.0"
  }
}
