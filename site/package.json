{
  "name": "com.regexsolver",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "predev": "node ../web-shared/scripts/sync-brand.mjs && npm ci --prefix ../web-shared --no-audit --no-fund",
    "prebuild": "node ../web-shared/scripts/sync-brand.mjs && npm ci --prefix ../web-shared --no-audit --no-fund",
    "build:wasm": "node scripts/build-wasm.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "gen:automaton": "node scripts/gen-automaton.mjs",
    "pretypecheck": "npm ci --prefix ../web-shared --no-audit --no-fund",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@regexsolver/web-shared": "file:../web-shared",
    "@tailwindcss/postcss": "^4.2.4",
    "@viz-js/viz": "^3.29.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.554.0",
    "next": "^16.2.11",
    "posthog-js": "^1.404.1",
    "prismjs": "^1.30.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.2"
  }
